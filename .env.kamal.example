# Copia a .env.kamal —que está gitignored— y rellena los valores reales.
#
# Es el ÚNICO sitio donde vive el valor de cada secreto. `.kamal/secrets` solo
# los referencia y `config/deploy.yml` solo declara sus nombres.
#
#   cd identia-matrix && source .env.kamal && kamal deploy
#
# ⚠ Cambiar de rama borra del disco lo que la rama de destino no sigue. Copia
# este fichero FUERA del repositorio antes de cualquier cirugía de ramas.

# --- Registro de imágenes (GHCR) ---
# El PAT necesita `write:packages`.
export KAMAL_REGISTRY_USERNAME=apcano1978
export KAMAL_REGISTRY_PASSWORD=replace-with-github-pat

# --- Rails ---
# El contenido de config/master.key.
export RAILS_MASTER_KEY=replace-with-master-key

# --- Postgres ---
# El accesorio `db` la reutiliza como POSTGRES_PASSWORD (ver .kamal/secrets).
export IDENTIA_MATRIX_DATABASE_PASSWORD=replace-with-strong-password

# --- Redis ---
# El host es el nombre del accesorio en la red de Kamal. NO apuntar a
# 172.17.0.1:6379: ése es el Redis de identia-platform, y compartirlo mezclaría
# las colas de Sidekiq y los cachés de las dos aplicaciones.
export REDIS_PASSWORD=replace-with-strong-password
export REDIS_URL=redis://:replace-with-strong-password@identia_matrix-redis:6379/0

# --- Sidekiq ---
# Sin esto la aplicación NO ARRANCA en producción: con la contraseña vacía,
# /sidekiq dejaba entrar con usuario y contraseña vacíos.
export SIDEKIQ_PASSWORD=replace-with-strong-password

# --- Autenticación (F7) ---
# Matrix no guarda ni verifica contraseñas: se las pregunta a platform por
# `POST /internal/v1/authenticate`. Este es el token del sujeto `matrix:auth`,
# cuyo único scope es `matrix:auth:verify` — no sirve para leer nada más.
#
# Se emite DENTRO de identia-platform:
#   cd ../identia-platform && bin/rails "matrix:issue_token[matrix:auth]"
#
# El valor se enseña una sola vez. Rotarlo es volver a ejecutar eso mismo: el
# anterior queda revocado, con su rastro de último uso.
export PLATFORM_API_TOKEN_AUTH=replace-me

# --- Active Record Encryption ---
# Se generan de una vez con `bin/rails db:encryption:init`. Sin ellas la
# aplicación no arranca en producción.
export AR_ENCRYPTION_PRIMARY_KEY=replace-me
export AR_ENCRYPTION_DETERMINISTIC_KEY=replace-me
export AR_ENCRYPTION_KEY_DERIVATION_SALT=replace-me

# --- Bucket de artefactos ---
# Credenciales del usuario IAM `identia-matrix-app`, que tiene PutObject,
# GetObject y ListBucket y NO tiene DeleteObject.
#
# OJO con el nombre: AWS_ARTIFACTS_BUCKET, no AWS_BUCKET como en platform.
export AWS_ACCESS_KEY_ID=replace-me
export AWS_SECRET_ACCESS_KEY=replace-me
export AWS_REGION=eu-west-1
export AWS_ARTIFACTS_BUCKET=identia-matrix-artifacts-prod
