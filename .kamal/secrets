# Kamal secrets — VERSIONADO (sin valores literales).
#
# Tres capas, y el valor de cada secreto vive en UNA SOLA:
#
#   .env.kamal          los valores        (gitignored, `export VAR=valor`)
#   .kamal/secrets      las referencias    (este fichero)
#   config/deploy.yml   solo los nombres   (env.secret)
#
# Desde local:
#
#   cd identia-matrix && source .env.kamal && kamal deploy
#
# (`source` exporta las variables; Kamal las resuelve aquí.)

KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

RAILS_MASTER_KEY=$RAILS_MASTER_KEY

IDENTIA_MATRIX_DATABASE_PASSWORD=$IDENTIA_MATRIX_DATABASE_PASSWORD
REDIS_PASSWORD=$REDIS_PASSWORD
REDIS_URL=$REDIS_URL
SIDEKIQ_PASSWORD=$SIDEKIQ_PASSWORD

# El accesorio Postgres reutiliza el mismo valor que la BD de la aplicación.
POSTGRES_PASSWORD=$IDENTIA_MATRIX_DATABASE_PASSWORD

# El token de `matrix:auth` contra la API interna de platform (F7).
PLATFORM_API_TOKEN_AUTH=$PLATFORM_API_TOKEN_AUTH

# Active Record Encryption. Obligatorias en producción.
AR_ENCRYPTION_PRIMARY_KEY=$AR_ENCRYPTION_PRIMARY_KEY
AR_ENCRYPTION_DETERMINISTIC_KEY=$AR_ENCRYPTION_DETERMINISTIC_KEY
AR_ENCRYPTION_KEY_DERIVATION_SALT=$AR_ENCRYPTION_KEY_DERIVATION_SALT

# El bucket de artefactos. REGION y BUCKET no son secretos, pero se enrutan
# aquí para tener un único sitio de configuración de despliegue.
AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
AWS_REGION=$AWS_REGION
AWS_ARTIFACTS_BUCKET=$AWS_ARTIFACTS_BUCKET
