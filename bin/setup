#!/usr/bin/env ruby
require "fileutils"

# Deja el entorno de desarrollo listo desde cero, y es idempotente: correrlo dos
# veces seguidas da el mismo resultado.
#
# A diferencia del bin/setup de la plantilla, este levanta los contenedores de
# respaldo y espera a que respondan. Sin esa espera, `db:prepare` corre contra un
# Postgres que todavía está inicializando y falla de forma intermitente — que es
# el peor modo de fallar, porque parece cosa de la máquina.

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

# Reintentos con tope sobre los servicios de respaldo. Devuelve cuando los dos
# responden; aborta con un mensaje útil si se agota el plazo.
def wait_for_backing_services!(attempts: 30, wait: 2)
  checks = {
    "Postgres" => "docker compose exec -T db pg_isready -q",
    "Redis"    => "docker compose exec -T redis redis-cli ping"
  }

  checks.each do |name, command|
    attempts.times do |attempt|
      return_value = system("#{command} > /dev/null 2>&1")
      if return_value
        puts "   #{name} responde"
        break
      end

      if attempt == attempts - 1
        abort <<~MSG

          #{name} no responde tras #{attempts * wait} segundos.

          Comprueba el estado con:  docker compose ps
          Y los logs con:           docker compose logs db redis
        MSG
      end

      sleep wait
    end
  end
end

FileUtils.chdir APP_ROOT do
  puts "== Variables de entorno =="
  if File.exist?(".env.development")
    puts "   .env.development ya existe"
  else
    FileUtils.cp ".env.development.example", ".env.development"
    puts "   creado .env.development desde el ejemplo"
  end

  puts "\n== Servicios de respaldo (Postgres 5435 · Redis 6381) =="
  system! "docker compose up -d db redis"
  wait_for_backing_services!

  puts "\n== Dependencias =="
  system("bundle check") || system!("bundle install")

  puts "\n== Base de datos =="
  system! "bin/rails db:prepare"

  puts "\n== Limpieza =="
  system! "bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Servidor de desarrollo =="
    puts "   http://localhost:3001"
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end

  puts "\nListo. Arranca con: bin/dev"
end
