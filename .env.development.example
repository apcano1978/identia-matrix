# Copia a .env.development y ajusta los valores para desarrollo local.
# Lo cargan los servicios `web`, `sidekiq` y `css` de compose.yml.

# --- Rails ---
RAILS_ENV=development
RAILS_MAX_THREADS=5

# --- Postgres ---
# Dentro de la red de compose el host es `db`. Desde la máquina anfitriona,
# el contenedor publica en 127.0.0.1:5435 (ver compose.yml).
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
IDENTIA_MATRIX_DATABASE_PASSWORD=devpassword

# --- Redis ---
# Sidekiq=db 0, cache=db 1. Desde el anfitrión, el contenedor publica en 6381.
REDIS_URL=redis://redis:6379/0

# --- Sidekiq ---
SIDEKIQ_CONCURRENCY=5
# La interfaz de /sidekiq solo pide usuario y contraseña en producción; en
# desarrollo queda abierta. Estos dos solo se rellenan en .env.kamal.
SIDEKIQ_USERNAME=
SIDEKIQ_PASSWORD=

# --- Runtime de agentes ---
# `fake` recorre el pipeline con artefactos de fixture, sin llamar a ningún
# modelo ni servicio externo. `brain` habla con identia-brain (F9).
MATRIX_AGENT_RUNTIME=fake
# Retardo del runtime falso, en segundos. Cero en test, siempre.
MATRIX_AGENT_RUNTIME_DELAY=0.4

# La proyección de identia-platform: `fake` sirve los datos de la maqueta,
# `platform` llama al API interno — y ese llega en F8.
MATRIX_PLATFORM_SOURCE=fake

# La lectura de código de los repositorios: `fake` sirve lo que el seed puso en
# la ficha, sin salir a la red; `remote` lee por la API del proveedor.
#
# Matrix NO clona: no ejecuta nada y nunca tiene código de cliente en su disco.
# La credencial se guarda con `matrix:credential`, por cliente y de solo lectura.
MATRIX_REPOSITORY_SOURCE=fake

# El login: `fake` autentica contra los usuarios ya proyectados con una
# contraseña compartida de desarrollo; `platform` llega en F7.
MATRIX_AUTH_SOURCE=fake
MATRIX_FAKE_AUTH_PASSWORD=matrix

# --- identia-brain (F9) ---
# El brain corre en su propio compose y publica el 8000 en el anfitrión.
# Desde los contenedores de Rails se alcanza vía host.docker.internal.
# AI_SERVICE_API_KEY es la clave PROPIA de matrix, distinta de la de platform.
# El brain la reconoce por su `AI_SERVICE_API_KEYS=matrix:<clave>`, y gracias a
# eso el ledger sabe separar lo que gasta matrix de lo que gasta platform sin
# depender de que el `X-Feature` de cada llamada esté bien puesto.
AI_SERVICE_URL=http://host.docker.internal:8000
AI_SERVICE_API_KEY=dev-insecure-token

# --- identia-platform (F7 y F8) ---
# UN TOKEN POR SUJETO, no uno solo: si el de la sincronización se filtrara, no
# debe servir para probar contraseñas contra platform. El agente de fachada
# `matrix` se descartó (dejaría agentes fantasma clicables en la intranet).
# Los emite platform con `matrix:issue_token[<sujeto>]`.
PLATFORM_API_URL=http://host.docker.internal:3000

# F7 · el login. Scope matrix:auth:verify.
PLATFORM_API_TOKEN_AUTH=

# F8 · la sincronización periódica. Scopes matrix:clients:read, matrix:projects:read.
PLATFORM_API_TOKEN_SYSTEM=

# F8 · la indexación de fuentes de TANK. Scope matrix:sources:read.
PLATFORM_API_TOKEN_TANK=

# --- Active Storage · bucket de artefactos (F5) ---
# En desarrollo el servicio es :local (disco). Estas variables solo hacen falta
# cuando se prueba contra S3 de verdad.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_ARTIFACTS_BUCKET=identia-matrix-artifacts-dev
