<%# Abrir un evolutivo (P1).

    Nace en `need` y ahí espera: el pipeline lo mueven los agentes, que llegan
    en F9. El aviso lo dice para que nadie busque un botón de avanzar que no
    existe. %>
<% if repositories.empty? %>
  <p class="mt-2.5 border border-terminal-border bg-terminal-sunken px-3.5 py-2.5
            text-t105 text-terminal-fg-3">
    Para abrir un evolutivo hace falta al menos un repositorio: un evolutivo
    es trabajo <em>sobre</em> código, y sin repositorio no habría nada que citar.
    Registra uno abajo.
  </p>
  <%# Y qué SÍ se puede hacer mientras tanto. La documentación no espera al
      repositorio: se reúne en platform y aparece aquí sola, que es justo para
      lo que sirve admitir a un cliente antes de que tenga proyecto. %>
  <p class="mt-1.5 text-t105 text-terminal-fg-3">
    Su documentación no espera a eso: lo que se suba en identia-platform aparece
    abajo, en fuentes, en cuanto pase el siguiente latido.
  </p>
<% else %>
  <details class="mt-2.5 border border-terminal-border bg-terminal-sunken">
    <summary class="cursor-pointer px-3.5 py-2 text-t11 text-terminal-fg-4
                    hover:text-antique-gold">
      + abrir un evolutivo
    </summary>

    <%# UN SOLO FORMULARIO Y UN SOLO POST, con los ficheros dentro.

        Dos formularios anidados no existen en HTML, y uno hermano recargaría la
        página al subir: se perdería el título escrito y el `details` se cerraría.
        Así el alta es un acto —lo que se sube, lo que se marca y lo que se abre
        van juntos— y la lista blanca no crece. %>
    <%= form_with url: project_initiatives_path(project), multipart: true,
                  data: { controller: "scope dropzone",
                          dropzone_autosubmit_value: false,
                          dropzone_over_class: "border-antique-gold",
                          scope_intact_value: "sin recortar · entra todo, también lo que se suba después",
                          scope_trimmed_value: "recortado a %{n} de %{total}",
                          action: "dragover->dropzone#over dragleave->dropzone#out " \
                                  "drop->dropzone#drop change->scope#render" },
                  class: "px-3.5 pb-3.5 pt-1" do |form| %>
      <%= form.text_field :title, required: true, autofocus: true,
                          placeholder: "qué hay que hacer · unificar precios y calendario",
                          class: "terminal-field focus:terminal-field-focus w-full" %>

      <%# ── DOCUMENTACIÓN DE PARTIDA ──────────────────────────────────────
          Qué fuentes entran en el ámbito de este evolutivo. Salen TODAS
          marcadas salvo las que no tienen cuerpo extraído: esas no viajarían
          igual, y ofrecerlas marcadas prometería algo que no ocurre.

          ⚠ Dejar el marcado por defecto NO escribe ni una fila. Recortar es un
          acto, y hasta que ocurre el evolutivo hereda todo lo que haya —también
          lo que se suba mañana—. La línea de estado lo dice, porque esa
          diferencia no se veía en ninguna parte y era el hueco P25. %>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="eyebrow text-terminal-muted">documentación de partida</span>
        <span class="text-t10 text-terminal-fg-3" data-scope-target="state">
          sin recortar · entra todo, también lo que se suba después
        </span>
      </div>

      <%# ⚠ EL TESTIGO. Un formulario HTML no manda las casillas SIN marcar, así
          que «desmarqué todas» y «este formulario no habla de ámbito» llegan
          exactamente igual: sin ningún parámetro. Este campo los distingue, y
          es lo que hace expresable el «arrancar solo con conversación» del
          rediseño. %>
      <%= hidden_field_tag :scope, "1" %>

      <% if sources.any? %>
        <div class="mt-1 flex flex-col gap-px">
          <% sources.each do |source| %>
            <label class="flex items-baseline gap-2.5 px-2 py-1.5 cursor-pointer
                          border border-terminal-border hover:border-terminal-border-gold">
              <%= check_box_tag source_field(source), source.id,
                                source_checked_by_default?(source),
                                id: nil, class: "accent-antique-gold",
                                data: { scope_target: "box",
                                        scope_default: source_checked_by_default?(source) } %>
              <span class="text-t11 text-terminal-fg"><%= source.slug %></span>
              <span class="text-t105 text-terminal-fg-3 truncate"><%= source.title %></span>
              <span class="ml-auto shrink-0 text-t95 text-terminal-muted">
                <%= source_origin(source) %>
              </span>
            </label>
          <% end %>
        </div>
      <% end %>

      <%# La subida, aquí mismo: «adjuntadas ahora · pasan a ser fuentes de este
          evolutivo». El arrastre NO envía —`dropzone_autosubmit_value: false`—
          porque enviar mandaría el evolutivo a medio escribir. %>
      <div data-dropzone-target="zone"
           class="mt-1.5 border border-dashed border-terminal-border-strong
                  px-3.5 py-3 text-center">
        <p class="text-t105 text-terminal-fg-3">Arrastra documentos aquí</p>
        <p class="mt-0.5 text-t10 text-terminal-fg-3">
          markdown, pdf, csv o transcripciones · se quedan dentro de este proyecto
        </p>
        <%# `id` propio: en esta misma pantalla vive el input de la zona de
            subida de la ficha, y dos `id="files"` serían HTML inválido —y una
            etiqueta que no se sabe a cuál apunta—. %>
        <%= form.file_field :files, multiple: true, name: "files[]",
                            id: "initiative-files",
                            data: { dropzone_target: "input",
                                    scope_target: "files" },
                            class: "mt-2 text-t10 text-terminal-fg-4" %>
      </div>

      <p class="mt-1.5 text-t10 text-terminal-fg-3">
        Sin documentación, todo lo que se decida nace sin cita de origen y
        MORFEO lo verá como derivado.
      </p>

      <%# ── ALCANCE ───────────────────────────────────────────────────────
          Sin commit al lado, y no por olvido: el anclaje es del PAR evolutivo ×
          repositorio, y ese par todavía no existe. Se fija al indexar, una sola
          vez, porque moverlo convertiría en mentira cada cita ya emitida. %>
      <div class="mt-3 flex items-baseline gap-2">
        <span class="eyebrow text-terminal-muted">alcance</span>
        <span class="text-t10 text-terminal-fg-3">
          qué repositorios puede leer TANK · al menos uno
        </span>
      </div>
      <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1.5">
        <% repositories.each do |repository| %>
          <label class="flex items-baseline gap-1.5 text-t11 text-terminal-fg-4
                        cursor-pointer hover:text-terminal-fg">
            <%= check_box_tag "repository_ids[]", repository.id, false,
                              id: "repo-#{repository.id}", class: "accent-antique-gold" %>
            <%= repository.name %>
          </label>
        <% end %>
      </div>

      <%# Un proyecto PROPIO no tiene ninguno de platform, y un desplegable vacío
          es peor que no estar: parece que falta algo por cargar. Se dice por qué
          no está, que es la mitad de lo que esta pantalla enseña. %>
      <% if projects.any? %>
        <div class="mt-3 flex items-baseline gap-2">
          <span class="eyebrow text-terminal-muted">proyecto en platform</span>
          <span class="text-t10 text-terminal-fg-3">
            opcional · es lo que hace que este evolutivo se alcance desde la ficha del proyecto
          </span>
        </div>
        <%= select_tag "platform_project_id",
                       options_from_collection_for_select(projects, :id, :name),
                       include_blank: "— sin vincular —",
                       class: "terminal-field focus:terminal-field-focus mt-1 w-full" %>
      <% elsif project.own? %>
        <p class="mt-3 text-t10 text-terminal-fg-3">
          Sin proyecto de platform al que vincularlo: este es un proyecto propio
          y no hay nada al otro lado.
        </p>
      <% end %>

      <p class="mt-3 text-t10 text-terminal-fg-3">
        Se abre en <span class="text-antique-gold">NEED</span> y ahí espera:
        el pipeline lo mueven los agentes, y todavía no están conectados.
      </p>

      <%= form.submit "abrir ⏎",
                      class: "mt-2.5 cursor-pointer border border-terminal-border-gold
                              bg-[rgba(196,155,94,.12)] px-3 py-1.5 text-t11
                              text-antique-gold hover:bg-[rgba(196,155,94,.2)]" %>
    <% end %>
  </details>
<% end %>
