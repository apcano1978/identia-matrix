<%# Los documentos SUBIDOS al proyecto (F12).

    Se citan igual que los de platform —`[src:doc/acta-precios#p2]`— y pesan lo
    mismo: un acta subida a mano y la misma llegada de platform tienen el mismo
    valor probatorio. Lo que cambia es quién responde de ella, y eso es lo que
    esta pantalla enseña.

    ⚠ NINGÚN ENLACE AL FICHERO, y es deliberado: matrix enseña TEXTO, nunca
    ficheros. Lo que se lee y se cita es el cuerpo extraído; el original se
    guarda por procedencia y para poder reextraer. `ArtifactAccess` cierra
    además la puerta del proxy de Active Storage a todo lo que no sea un
    artefacto. %>
<%= section_header "DOCUMENTOS", count: documents.size, tone: :gate2,
                   gloss: "fuentes propias del proyecto · ◆ origen, como las de platform" %>

<%= form_with url: project_documents_path(project), multipart: true,
              data: { controller: "dropzone",
                      dropzone_over_class: "border-antique-gold",
                      action: "dragover->dropzone#over dragleave->dropzone#out " \
                              "drop->dropzone#drop" },
              class: "mt-2.5" do |form| %>
  <div data-dropzone-target="zone"
       class="border border-dashed border-terminal-border-strong bg-terminal-sunken
              px-3.5 py-5 text-center">
    <p class="text-t12 text-terminal-fg-3">Arrastra documentos aquí</p>
    <p class="mt-1 text-t10 text-terminal-fg-3">
      markdown, pdf, csv o transcripciones · se quedan dentro de este proyecto
    </p>

    <%# El input, visible y utilizable. Sin JS esto es la pantalla entera. %>
    <%= form.file_field :files, multiple: true, name: "files[]",
                        data: { dropzone_target: "input",
                                action: "change->dropzone#submit" },
                        class: "mt-2.5 text-t105 text-terminal-fg-4" %>
    <%= form.submit "subir ⏎",
                    class: "ml-2 cursor-pointer border border-terminal-border-gold
                            bg-[rgba(196,155,94,.12)] px-3 py-1 text-t105
                            text-antique-gold hover:bg-[rgba(196,155,94,.2)]" %>
  </div>
<% end %>

<% if documents.any? %>
  <div class="mt-2.5 border border-terminal-border">
    <% documents.each do |document| %>
      <%= render "projects/document", document: document, project: project %>
    <% end %>
  </div>
<% else %>
  <%# Sin documentos no es un hueco: es de donde se parte. La frase es la del
      rediseño, y es la que dice qué hacer. %>
  <p class="mt-2.5 text-t105 leading-[1.6] text-terminal-fg-3">
    Todavía no hay ninguno. Sin documentación, todo lo que se decida nace sin
    cita de origen y MORFEO lo verá como derivado.
  </p>
<% end %>

<%# Los retirados, aparte y en apagado. Siguen existiendo y siguen resolviendo
    las citas ya emitidas: retirar los saca del ámbito de los evolutivos NUEVOS,
    no del sistema. %>
<% if retired.any? %>
  <p class="mt-3 eyebrow text-terminal-fg-3">RETIRADOS (<%= retired.size %>)</p>
  <div class="mt-1 flex flex-col gap-1">
    <% retired.each do |document| %>
      <div class="flex items-baseline gap-2 text-t105 text-terminal-disabled"
           data-retired="<%= document.slug %>">
        <span><%= document.slug %></span>
        <span class="text-t95">retirado <%= l(document.retired_at.to_date, format: :short) %></span>
        <span class="ml-auto text-t95">sigue resolviendo las citas ya emitidas</span>
      </div>
    <% end %>
  </div>
<% end %>
