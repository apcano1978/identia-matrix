<% breadcrumb "projects" %>
<% content_for :title, "identia-matrix · proyectos" %>

<%= render "shared/view_bar",
           notes: [ "ningún agente cruza la frontera de proyecto" ] do %>
  <%# Las dos pestañas. Los contadores van SIEMPRE los dos, aunque solo se pinte
      una lista: una pestaña que no dice cuántos hay detrás no invita a pulsarla,
      y la de propios está vacía hasta que exista «matrix interna». %>
  <div class="flex border border-terminal-border">
    <% [ [ "de-cliente", "DE CLIENTE" ], [ "propios", "PROPIOS" ] ].each do |tab, label| %>
      <%= link_to projects_path(tab: tab), data: { tab: tab },
                  class: "px-3 py-0.5 font-sans text-t10 font-medium tracking-[.1em] #{
                    @tab == tab ? 'bg-terminal-fg text-ink'
                                : 'text-terminal-fg-3 hover:text-terminal-fg'}" do %>
        <%= label %> · <%= @counts.fetch(tab) %>
      <% end %>
    <% end %>
  </div>

  <%= link_to "+ NUEVO PROYECTO", new_project_path,
              class: "ml-3 bg-antique-gold px-3 py-1 font-sans text-t10
                      font-semibold tracking-[.09em] text-ink hover:opacity-90" %>
<% end %>

<div class="flex-1 min-h-0 overflow-y-auto px-5 pt-[18px] pb-5">
  <%= section_header "PROYECTOS", count: @pagy.count,
                     gloss: "proyecto → evolutivos × repositorios", tone: :gate2 %>

  <div class="grid grid-cols-3 items-start gap-[13px] mt-3">
    <%= render partial: "projects/card", collection: @projects, as: :project %>
  </div>

  <%# La pestaña vacía dice qué falta, no se queda en blanco. La de propios lo
      estará hasta B10, y es un estado correcto, no un fallo. %>
  <% if @projects.empty? %>
    <p class="mt-3 p-[11px_12px] border border-terminal-border bg-terminal-sunken
              text-t105 leading-[1.65] text-terminal-fg-3">
      <% if @tab == "propios" %>
        Matrix todavía no trabaja sobre nada suyo. Un proyecto propio vive solo
        aquí, sin cliente detrás y sin sincronización.
      <% else %>
        Ningún cliente de identia-platform tiene proyecto todavía. Llegan solos
        en el siguiente latido de sincronización.
      <% end %>
    </p>
  <% end %>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>

  <p class="mt-4 text-t105 text-terminal-fg-3">
    ↳ el evolutivo es el eje de trabajo; el repositorio, el eje de memoria
  </p>
</div>
