<% breadcrumb "projects", @project.slug, @initiative.slug, "acta" %>
<% content_for :title, "identia-matrix · acta de #{@initiative.slug}" %>

<%= render "shared/view_bar",
           back: { label: @initiative.slug, path: initiative_path_for },
           title: "cierre de requisitos",
           notes: [ acta_cost_note(@runs),
                    @acta ? "inmutable · #{@acta.storage_key}" : "sin publicar" ] %>

<div class="flex-1 min-h-0 flex">
  <div class="flex-1 min-w-0 overflow-y-auto px-[22px] pt-[18px] pb-5">
    <div class="flex items-baseline gap-3.5">
      <h1 class="font-sans text-t27 font-semibold tracking-tight text-terminal-fg">
        Acta de decisiones
      </h1>
      <%# El titular cuenta DECIDIDO contra PENDIENTE, y por eso las descartadas
          suman con las cerradas: descartar también es haber decidido. Lo que
          separa esta cifra es lo que queda por contestar. %>
      <span class="text-t105 text-terminal-fg-3">
        <%= pluralize(@closed_count, "cerrada") %> ·
        <%= pluralize(@open_count, "abierta") %>
      </span>
    </div>

    <%# ── Las tres pestañas de filtro ─────────────────────────────────────
        Son GET con parámetro, no un filtro de cliente: así una pestaña se puede
        enlazar y compartir, que es lo que hace falta cuando alguien pregunta
        «¿qué queda abierto?». %>
    <div class="flex items-baseline gap-2.5 mt-3.5">
      <% [ [ "todas", "TODAS", @decisions.size ],
           [ "cerradas", "CERRADAS", @closed_count ],
           [ "abiertas", "ABIERTAS", @open_count ] ].each do |tab, label, count| %>
        <%= link_to project_initiative_acta_path(@project, @initiative,
                                                 tab: tab == "todas" ? nil : tab),
                    data: { tab: tab },
                    class: "px-2.5 py-0.5 font-sans text-t10 font-medium
                            tracking-[.1em] border #{
                      @tab == tab ? 'border-antique-gold bg-[rgba(196,155,94,.12)] text-antique-gold'
                                  : 'border-terminal-border text-terminal-fg-3 hover:text-terminal-fg'}" do %>
          <%= label %> · <%= count %>
        <% end %>
      <% end %>
    </div>

    <div class="mt-3.5 flex flex-col">
      <% @visible.each do |decision| %>
        <%= render "actas/decision", decision: decision, acta: @acta %>
      <% end %>
    </div>

    <%# El acta vacía no es un hueco: es el estado con el que nace un evolutivo,
        y es desde donde se empieza a hablar. La pantalla dice qué hacer en vez
        de quedarse en blanco. %>
    <% if @decisions.empty? %>
      <p class="mt-3 p-[11px_12px] border border-dashed border-terminal-border
                text-t105 leading-[1.65] text-terminal-fg-3">
        Todavía no hay ninguna decisión. El
        <span class="text-antique-gold">ARQUITECTO</span> las levanta
        preguntando: cuéntale a la derecha qué hay que hacer y qué restricciones
        conoces, y él irá cerrando lo que se pueda cerrar y anotando lo que no.
      </p>
    <% end %>

    <%# Una decisión abierta NO impide avanzar, y esta línea es la mitad de por
        qué el acta existe: se arrastra hasta que alguien la conteste. %>
    <% if @open_count.positive? %>
      <p class="mt-4 border-l-2 border-terminal-border-gold
                bg-[rgba(196,155,94,.08)] px-3.5 py-2.5
                text-t105 leading-[1.6] text-terminal-fg-3">
        <%= pluralize(@open_count, "decisión abierta", plural: "decisiones abiertas") %>
        <span class="text-terminal-fg">no bloquean el avance</span>, pero se
        arrastran: MORFEO las levanta como advertencia al revisar y LINK las
        recupera al cerrar. Lo que no puede pasar es que se pierdan.
      </p>
    <% end %>
  </div>

  <%= side_panel(width: 258) do %>
    <%= panel_block("EL ACTA") do %>
      <p class="text-t105 leading-[1.65] text-terminal-fg-3">
        La escribe el <span class="text-antique-gold">ARQUITECTO</span> en la
        etapa de necesidad, preguntando hasta cerrar cada decisión. De ella sale
        la especificación: lo que aquí quede sin contestar, allí queda sin
        definir.
      </p>
    <% end %>

    <%= panel_block("SESIONES") do %>
      <% if @runs.any? %>
        <dl class="text-t105 leading-[1.8]">
          <% @runs.each do |run| %>
            <%= render "initiatives/fact", term: run.purpose,
                       value: "#{run.code.split('/').last} · #{run.total_tokens} tok" %>
          <% end %>
        </dl>
      <% else %>
        <p class="text-t105 text-terminal-fg-3">Sin ejecuciones registradas.</p>
      <% end %>
    <% end %>

    <%# ── CONVERSACIÓN ────────────────────────────────────────────────────

        La mitad de la persona, y solo esa. La del ARQUITECTO es la lista de
        decisiones de la izquierda: su respuesta no es prosa, así que no se
        guarda como prosa y no hay tabla de chat.

        Cada frase queda como `HumanNote`: nivel ORIGEN y CITABLE, que es lo que
        hace falta para que la respuesta de una decisión pueda señalar quién la
        dio. %>
    <%= panel_block("CONVERSACIÓN") do %>
      <% if @notes.any? %>
        <div class="flex flex-col gap-2.5 mb-3">
          <% @notes.each do |note| %>
            <div>
              <div class="flex items-baseline gap-2 text-t95">
                <span class="text-terminal-fg-4"><%= note.author_user.name %></span>
                <span class="ml-auto text-terminal-muted"><%= note.code %></span>
              </div>
              <p class="mt-0.5 text-t105 leading-[1.55] text-terminal-fg-3">
                <%= note.body %>
              </p>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @acta %>
        <%# Cerrada el acta, la conversación no continúa: de ella salen la spec y
            los deltas, y lo que cambie a partir de aquí es otro delta. %>
        <p class="text-t105 leading-[1.65] text-terminal-fg-3">
          El acta está cerrada. Lo que haya que cambiar a partir de aquí es otro
          delta, no un turno más de esta conversación.
        </p>
      <% else %>
        <%= form_with url: project_initiative_acta_turn_path(@project, @initiative) do |form| %>
          <%= form.text_area :message, rows: 4, required: true,
                             placeholder: "Puede cachear disponibilidad, no precio.",
                             class: "terminal-field focus:terminal-field-focus w-full" %>
          <%= form.submit "Responder al ARQUITECTO",
                          class: "mt-2 w-full cursor-pointer border
                                  border-terminal-border-gold bg-[rgba(196,155,94,.12)]
                                  px-3 py-1.5 text-t11 text-antique-gold
                                  hover:bg-[rgba(196,155,94,.2)]" %>
        <% end %>
        <p class="mt-1.5 text-t10 text-terminal-fg-3">
          Contesta en el acto: es lo único de matrix que no pasa por una cola.
        </p>
      <% end %>
    <% end %>

    <%# ── CERRAR ──────────────────────────────────────────────────────────
        Solo mientras haya algo que cerrar. Cerrar publica el acta y sale de la
        etapa 1: lo que había que decidir está decidido. %>
    <% if @acta.nil? && @decisions.any? %>
      <%= panel_block("CERRAR EL ACTA") do %>
        <p class="text-t105 leading-[1.65] text-terminal-fg-3">
          <% if @open_count.positive? %>
            Se cierra con
            <span class="text-antique-gold"><%= pluralize(@open_count, "decisión abierta", plural: "decisiones abiertas") %></span>.
            No bloquean: se arrastran, y MORFEO las levantará al revisar.
          <% else %>
            No queda ninguna pregunta sin contestar.
          <% end %>
          Publica el acta y el evolutivo entra en TANK.
        </p>

        <%= button_to "CERRAR Y PASAR A TANK",
                      project_initiative_acta_closure_path(@project, @initiative),
                      class: "mt-2.5 w-full cursor-pointer border-0 bg-antique-gold
                              px-3 py-2 font-sans text-t10 font-semibold
                              tracking-[.09em] text-ink hover:opacity-90" %>
      <% end %>
    <% end %>
  <% end %>
</div>
