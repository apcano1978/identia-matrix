<!DOCTYPE html>
<html lang="es">
  <head><%= render "layouts/document_head" %></head>

  <%# 1280 px de ancho mínimo y NADA de scroll en la página: el scroll vive
      dentro de cada panel. Es la adaptación del lienzo fijo de 1440×900 de la
      maqueta — la columna central es fluida, los laterales no. %>
  <body class="h-screen min-w-[1280px] overflow-hidden flex bg-terminal-bg">
    <%= render "layouts/rail" %>

    <div class="flex-1 min-w-0 flex flex-col">
      <%= render "layouts/title_bar" %>
      <main class="flex-1 min-h-0 flex flex-col">
        <%= render "layouts/flash" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
