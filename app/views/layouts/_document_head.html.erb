<%# La cabecera compartida por los dos layouts. Está aparte para que el login y
    la página de diagnóstico —que no pueden llevar rail— no dupliquen fuentes,
    importmap ni tokens. %>
<meta charset="utf-8">
<title><%= content_for(:title) || "identia-matrix" %></title>
<meta name="viewport" content="width=1280">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%= yield :head %>

<%# El mismo icono que identia-platform, byte a byte: es una sola marca. Se
    sirve desde `public/` y no por el pipeline, igual que allí. %>
<link rel="icon" href="/icon.png" type="image/png">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon.png">

<%# Misma familia tipográfica y misma fuente de servicio que identia-platform.
    JetBrains Mono es la voz dominante de matrix; Outfit y Source Serif 4
    aparecen en rótulos y en la prosa de la guía de pruebas. %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
