<% breadcrumb "projects", @project.slug, @initiative.slug %>
<% content_for :title, "identia-matrix · #{@initiative.code}" %>

<%= render "initiatives/view_bar", project: @project, initiative: @initiative,
           artifacts: @artifacts, artifact: @artifact %>

<div class="flex-1 min-h-0 flex">
  <%= render "initiatives/pipeline", initiative: @initiative %>
  <%= render "initiatives/viewer", initiative: @initiative, artifact: @artifact,
             report: @report, versions: @versions, mode: @mode,
             compared: @compared, diff: @diff %>
  <%= render "initiatives/panel", initiative: @initiative, artifact: @artifact,
             events: @events, refs: @refs %>
</div>
