<%# El visor, con sus tres modos.

    `rendered` enseña el cuerpo; `source`, el DOCUMENTO entero —cabecera
    incluida—, que es literalmente lo que hay en el bucket; `diff`, qué cambió
    entre dos versiones consecutivas.

    Todo por GET: esta pantalla no escribe nada, y el selector de versión son
    enlaces y no un `<select>` porque un select necesitaría un formulario. %>
<section class="flex-1 min-w-0 flex flex-col border-r border-terminal-border">
  <div class="h-[30px] flex-none flex items-center gap-2.5 px-4
              bg-terminal-rail border-b border-terminal-border">
    <% if artifact %>
      <span class="text-t11 text-terminal-fg"><%= artifact.code %>.md</span>
      <span class="text-t10 text-terminal-muted">· <%= artifact_run_label(artifact) %></span>

      <%# El selector de versión. Solo aparece cuando hay más de una: una sola
          versión no es una elección. %>
      <% if versions.size > 1 %>
        <span class="flex items-center gap-1.5 text-t10">
          <% versions.each do |other| %>
            <% if other == artifact %>
              <span class="text-antique-gold">v<%= other.version %></span>
            <% else %>
              <%= link_to "v#{other.version}",
                          client_initiative_path(initiative.platform_client, initiative,
                                                 artifact: other.code,
                                                 version: other.version, view: mode),
                          class: "text-terminal-fg-4" %>
            <% end %>
          <% end %>
        </span>
      <% end %>
    <% else %>
      <span class="text-t11 text-terminal-disabled">sin artefactos todavía</span>
    <% end %>

    <div class="ml-auto flex gap-3 text-t10 text-terminal-muted">
      <%= viewer_mode_link "source", mode: :source, initiative: initiative,
                           artifact: artifact, current: mode %>
      <%= viewer_mode_link "rendered", mode: :rendered, initiative: initiative,
                           artifact: artifact, current: mode %>

      <%# Un artefacto de una sola versión no ofrece diff: no hay contra qué
          comparar. Mismo tratamiento que las pestañas sin artefacto de F3. %>
      <% if versions.size > 1 %>
        <%= viewer_mode_link "diff", mode: :diff, initiative: initiative,
                             artifact: artifact, current: mode %>
      <% else %>
        <span class="text-terminal-disabled cursor-not-allowed"
              title="<%= artifact ? "#{artifact.code} solo tiene una versión: no hay contra qué compararla" : 'no hay artefacto que comparar' %>">diff</span>
      <% end %>
    </div>
  </div>

  <% if (banner = cycle_banner(initiative, report)) %>
    <div class="flex-none flex items-center gap-2.5 px-4 py-2.5 border-b
                <%= banner.tone == :ok ? 'bg-[rgba(240,233,215,.05)] border-terminal-border-strong'
                                       : 'bg-[rgba(201,128,112,.09)] border-terminal-border-fail' %>">
      <span class="text-t12 <%= banner.tone == :ok ? 'text-glyph-gate2' : 'text-glyph-fail' %>">
        <%= banner.glyph %>
      </span>
      <span class="text-t115 text-terminal-fg"><%= banner.text %></span>
      <span class="ml-auto flex-none whitespace-nowrap text-t105
                   text-terminal-disabled cursor-not-allowed"
            title="el informe de verificación tiene su propia pantalla en F6">
        ver informe →
      </span>
    </div>
  <% end %>

  <div class="flex-1 min-h-0 overflow-y-auto <%= mode == :rendered ? 'px-4 py-3.5' : '' %>">
    <% case mode %>
    <% when :source %>
      <%= render "initiatives/viewer_source", artifact: artifact %>
    <% when :diff %>
      <%= render "initiatives/viewer_diff", artifact: artifact,
                 compared: compared, diff: diff %>
    <% else %>
      <%= markdown artifact&.body_markdown %>
    <% end %>
  </div>

  <%# `whitespace-nowrap` y `truncate`: es una barra de 28 px de alto y su
      contenido tiene que caber en una línea. Sin esto, la clave del artefacto
      —que es larga y no se puede acortar— parte la barra en dos y la corta. %>
  <div class="h-7 flex-none flex items-center gap-4 px-4 bg-terminal-rail
              border-t border-terminal-border text-t10 text-terminal-fg-4
              whitespace-nowrap overflow-hidden">
    <% state = situation(initiative) %>
    <span class="px-2 py-0.5 font-medium text-terminal-bg
                 <%= state.colour.sub('text-', 'bg-') %>">
      <%= state.label.upcase %>
    </span>
    <% if artifact %>
      <span class="truncate"><%= artifact.storage_key %></span>
      <span><%= pluralize artifact.citations.size, "cita" %></span>
    <% end %>
    <span class="ml-auto flex-none">iteración <%= initiative.iteration %> ·
      ciclo QA <%= initiative.qa_cycles_consumed %>/<%= Initiative::MAX_QA_CYCLES %></span>
  </div>
</section>
