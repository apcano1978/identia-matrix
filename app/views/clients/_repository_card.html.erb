<% last = last_touch(repository) %>
<%= link_to client_repository_path(client.slug, repository.name),
            class: "flex flex-col p-[13px_14px] bg-terminal-sunken
                    border border-terminal-border" do %>
  <div class="flex items-baseline gap-2 w-full">
    <span class="text-t13 font-medium text-terminal-fg"><%= repository.name %></span>
    <span class="ml-auto text-t10 <%= repository.initiatives.size > 1 ?
          'text-antique-gold' : 'text-terminal-fg-3' %>">
      <%= pluralize repository.initiatives.size, "evolutivo" %>
    </span>
  </div>
  <div class="mt-1.5 text-t105 text-terminal-fg-4">
    head <span class="text-antique-gold"><%= repository.head_sha || "—" %></span>
    · <%= repository.default_branch %>
  </div>
  <div class="mt-1 text-t105 text-terminal-muted">
    <% if last %>
      último · <%= last.code %> · hace <%= age_label(last.stage_changed_at,
                                                     Time.current - last.stage_changed_at) %>
    <% else %>
      sin evolutivos todavía
    <% end %>
  </div>
<% end %>
