<% breadcrumb "clients", @client.slug %>
<% content_for :title, "identia-matrix · #{@client.slug}" %>

<%# El aviso de la sub-barra fija la relación con el otro repo, y no es un
    detalle: es la razón por la que esta pantalla no tiene un solo formulario. %>
<%= render "shared/view_bar", back: { label: "clientes", path: clients_path },
           title: @client.slug,
           notes: [ "el cliente y sus proyectos se gestionan en identia-platform · " \
                    "los evolutivos y los repositorios son de matrix" ] %>

<div class="flex-1 min-h-0 flex">
  <div class="flex-1 min-w-0 overflow-y-auto px-[22px] pt-[18px] pb-5">
    <div class="flex items-baseline gap-3.5">
      <h1 class="font-sans text-t27 font-semibold tracking-[.03em] text-terminal-fg">
        <%= @client.name %>
      </h1>
      <span class="text-t12 text-terminal-fg-4"><%= @client.sector %></span>
      <%# Admitido antes de tener proyecto: la ficha lo dice para que la ausencia
          de evolutivos se lea como el estado que es y no como algo que falta. %>
      <% if @client.in_preparation? %>
        <span class="eyebrow text-terminal-fg-3 border border-dashed
                     border-terminal-border-strong px-1.5 py-px">EN PREPARACIÓN</span>
      <% end %>
      <span class="ml-auto flex items-baseline gap-3">
        <%= client_sync_state(@client) %>
        <span class="text-t105 text-terminal-muted"><%= client_contact(@client) %></span>
      </span>
    </div>

    <%= section_header "PROYECTOS", count: @projects.size, tone: :gate2,
                       gloss: "de aquí cuelgan los evolutivos y los repositorios" %>
    <div class="grid grid-cols-2 items-start gap-[13px] mt-2.5">
      <%= render partial: "projects/card", collection: @projects, as: :project %>
    </div>

    <%= render "clients/client_sources", client: @client %>
  </div>

</div>
