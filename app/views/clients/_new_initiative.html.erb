<%# Abrir un evolutivo (P1).

    Nace en `need` y ahí espera: el pipeline lo mueven los agentes, que llegan
    en F9. El aviso lo dice para que nadie busque un botón de avanzar que no
    existe. %>
<% if repositories.empty? %>
  <p class="mt-2.5 border border-terminal-border bg-terminal-sunken px-3.5 py-2.5
            text-t105 text-terminal-fg-3">
    Para abrir un evolutivo hace falta al menos un repositorio: un evolutivo
    es trabajo <em>sobre</em> código, y sin repositorio no habría nada que citar.
    Registra uno abajo.
  </p>
<% else %>
  <details class="mt-2.5 border border-terminal-border bg-terminal-sunken">
    <summary class="cursor-pointer px-3.5 py-2 text-t11 text-terminal-fg-4
                    hover:text-antique-gold">
      + abrir un evolutivo
    </summary>

    <%= form_with url: client_initiatives_path(client), class: "px-3.5 pb-3.5 pt-1" do |form| %>
      <%= form.text_field :title, required: true, autofocus: true,
                          placeholder: "qué hay que hacer · unificar precios y calendario",
                          class: "terminal-field focus:terminal-field-focus w-full" %>

      <div class="mt-3 flex items-baseline gap-2">
        <span class="eyebrow text-terminal-muted">repositorios que toca</span>
        <span class="text-t10 text-terminal-fg-3">al menos uno · varios si es multi-repo</span>
      </div>
      <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1.5">
        <% repositories.each do |repository| %>
          <label class="flex items-baseline gap-1.5 text-t11 text-terminal-fg-4
                        cursor-pointer hover:text-terminal-fg">
            <%= check_box_tag "repository_ids[]", repository.id, false,
                              id: "repo-#{repository.id}", class: "accent-antique-gold" %>
            <%= repository.name %>
          </label>
        <% end %>
      </div>

      <div class="mt-3 flex items-baseline gap-2">
        <span class="eyebrow text-terminal-muted">proyecto en platform</span>
        <span class="text-t10 text-terminal-fg-3">
          opcional · es lo que hace que este evolutivo se alcance desde la ficha del proyecto
        </span>
      </div>
      <%= select_tag "platform_project_id",
                     options_from_collection_for_select(projects, :id, :name),
                     include_blank: "— sin vincular —",
                     class: "terminal-field focus:terminal-field-focus mt-1 w-full" %>

      <p class="mt-3 text-t10 text-terminal-fg-3">
        Se abre en <span class="text-antique-gold">NEED</span> y ahí espera:
        el pipeline lo mueven los agentes, y todavía no están conectados.
      </p>

      <%= form.submit "abrir ⏎",
                      class: "mt-2.5 cursor-pointer border border-terminal-border-gold
                              bg-[rgba(196,155,94,.12)] px-3 py-1.5 text-t11
                              text-antique-gold hover:bg-[rgba(196,155,94,.2)]" %>
    <% end %>
  </details>
<% end %>
