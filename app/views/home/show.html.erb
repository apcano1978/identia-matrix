<% content_for :title, "identia-matrix · diagnóstico" %>

<%# Página de diagnóstico del entorno. Deliberadamente desechable: en F3 la
    sustituye el dashboard. Ejercita la capa de tokens de F0 de punta a punta —
    fuentes, superficies, glifos — para que no se descubra en F3 que algo de
    aquello no se aplicaba. %>

<main class="min-h-screen bg-terminal-bg px-8 py-10 font-mono">
  <div class="mx-auto max-w-3xl">

    <header class="border-b border-terminal-border pb-5">
      <p class="eyebrow text-terminal-muted">D I A G N Ó S T I C O   D E L   E N T O R N O</p>
      <h1 class="mt-3 text-t27 text-terminal-fg">identia-matrix</h1>
      <p class="mt-2 text-t12 text-terminal-fg-3">
        <%= Rails.env %> · Rails <%= Rails.version %> · Ruby <%= RUBY_VERSION %>
        <span class="text-terminal-sep"> / </span>
        <%= link_to "/up", rails_health_check_path, class: "text-antique-gold" %>
        <span class="text-terminal-sep"> · </span>
        <%= link_to "/sidekiq", "/sidekiq", class: "text-antique-gold" %>
      </p>
    </header>

    <section class="mt-8">
      <div class="flex items-baseline gap-3">
        <span class="text-t105 text-antique-gold">## COMPROBACIONES</span>
        <span class="text-t105 text-terminal-muted">(<%= @checks.size %>)</span>
        <div class="h-px flex-1 bg-terminal-border"></div>
        <span class="text-t11 text-terminal-muted">¿está el entorno entero en pie?</span>
      </div>

      <ul class="mt-4">
        <% @checks.each do |check| %>
          <li class="grid grid-cols-[20px_180px_1fr] items-baseline gap-3 border-b border-terminal-border py-3">
            <span class="text-t11"><%= glyph(check.status) %></span>
            <span class="text-t12 text-terminal-fg"><%= check.label %></span>
            <span class="text-t115 <%= check.ok? ? "text-terminal-fg-4" : "text-glyph-fail" %>">
              <%= check.detail %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>

    <footer class="mt-8 flex items-baseline gap-4 text-t11 text-terminal-muted">
      <span><%= glyph(:ok) %> responde</span>
      <span><%= glyph(:failed) %> no responde</span>
      <span><%= glyph(:pending) %> aún no aplica</span>
      <span class="ml-auto text-terminal-disabled">
        esta pantalla desaparece en F3
      </span>
    </footer>

  </div>
</main>
