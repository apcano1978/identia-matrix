<%# El editor de configuración (P2). Es el único formulario de matrix que no es
    un alta: ver `AgentConfigsController` para el porqué.

    Se edita el JSON del ámbito que se está mirando, y no un formulario campo a
    campo, porque `settings` no tiene forma fija —cada agente trae las suyas y
    la maqueta las cambia por panel—. Un formulario generado a partir de las
    claves existentes solo dejaría editar lo que ya hay, y añadir un ajuste
    nuevo obligaría a tocar código. %>
<% locked = AgentConfig.locked_for(agent) %>
<% current = client ? override : global %>

<div class="mt-[26px] border-t border-terminal-border pt-[18px]">
  <div class="flex items-baseline gap-3">
    <h2 class="eyebrow text-terminal-fg-3">
      EDITAR · <%= client ? "override de #{client.slug}" : "configuración global" %>
    </h2>
    <span class="text-t10 text-terminal-fg-4">
      <% if client %>
        lo que no se declare aquí se hereda de la global
      <% else %>
        la base de todos los clientes
      <% end %>
    </span>
  </div>

  <% if client && locked.any? %>
    <%# Se dice ANTES de escribir, no después de podar: enterarse de que un
        cambio no se guardó al ver que no cambió nada es la peor forma. %>
    <p class="mt-2 text-t10 text-terminal-muted">
      No admiten override:
      <% locked.each do |path| %>
        <code class="text-antique-gold"><%= path %></code><%= " · " unless path == locked.last %>
      <% end %>
      — sostienen invariantes, y cambiarlos por cliente sería comprar otra política.
    </p>
  <% end %>

  <%= form_with url: agent_config_path(agent, scope: client&.slug), method: :patch,
                class: "mt-3" do |form| %>
    <%= form.text_area :settings, value: JSON.pretty_generate(current),
                       rows: [ [ current.to_json.size / 60, 8 ].max, 24 ].min,
                       spellcheck: false,
                       class: "w-full bg-terminal-sunken border border-terminal-border
                               px-3 py-2 font-mono text-t105 text-terminal-fg" %>
    <div class="mt-2.5 flex items-center gap-3">
      <%= form.submit "guardar", class: "border border-terminal-border-gold
                                         bg-antique-gold px-3 py-1.5 text-t105
                                         text-terminal-bg cursor-pointer" %>
      <span class="text-t10 text-terminal-fg-4">
        Las ejecuciones en curso conservan la configuración con la que empezaron.
      </span>
    </div>
  <% end %>
</div>
