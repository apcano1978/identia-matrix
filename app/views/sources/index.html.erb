<% breadcrumb "projects", @project.slug, @initiative.slug, "sources" %>
<% content_for :title, "identia-matrix · fuentes de #{@initiative.code}" %>

<%= render "shared/view_bar",
           back: { label: @initiative.slug,
                   path: project_initiative_path(@project, @initiative) },
           title: "fuentes",
           notes: [ pluralize(@links.size, "repo") ] %>

<div class="flex-1 min-h-0 overflow-y-auto px-[22px] pt-[18px] pb-6">
  <div class="flex items-baseline gap-3.5">
    <h1 class="font-sans text-t27 font-semibold tracking-tight text-terminal-fg">
      Fuentes en ámbito
    </h1>
    <span class="text-t105 text-terminal-fg-3">
      lo que TANK puede leer y citar para <%= @initiative.code %>
    </span>
    <span class="ml-auto">
      <%= status_chip "write access: none", tone: :fail %>
    </span>
  </div>

  <%# ── CÓDIGO ────────────────────────────────────────────────────────────
      El commit FIJADO, no la cabeza del repositorio: un evolutivo trabaja
      contra un punto concreto de la historia, y las citas que emita se anclan
      ahí. %>
  <%= section_header "CÓDIGO · #{pluralize(@links.size, 'REPOSITORIO').upcase}",
                     gloss: "cada cita lleva su calificador de repositorio" %>

  <div class="mt-[9px] border border-terminal-border-gold text-t10">
    <div class="grid-source-repos px-3 py-1.5 bg-terminal-bg text-t9
                tracking-[.08em] text-terminal-fg-4
                border-b border-terminal-border-gold">
      <span>REPOSITORIO</span>
      <span>COMMIT FIJADO</span>
      <span>INDEXADO</span>
      <span>PREFIJO DE CITA</span>
    </div>

    <% @links.each do |link| %>
      <div class="grid-source-repos items-center px-3 py-2.5
                  border-b border-terminal-border last:border-b-0">
        <%= link_to link.repository.name,
                    project_repository_path(@project, link.repository),
                    class: "text-terminal-fg" %>
        <%# ⚠ Y POR QUÉ no está anclado, si no lo está (F12 · B6). «sin anclar»
            a secas no decía nada accionable, y es justo el estado en el que un
            agente trabajaría sin haber leído el código. %>
        <% pinned = pinned_state(link) %>
        <span class="<%= pinned.tone %>"><%= pinned.glyph %> <%= pinned.label %></span>
        <span class="text-terminal-fg-3"><%= indexed_files(link.repository) %></span>
        <%# Didáctico: es la forma exacta que hay que escribir para citarlo. %>
        <span class="text-terminal-fg-3"><%= citation_prefix(link.repository) %></span>
      </div>
    <% end %>
  </div>

  <%# ── LO DOCUMENTAL, Y AHORA SE PUEDE TOCAR (F12 · B5) ──────────────────
      Un solo formulario envuelve las tres tarjetas: el ámbito es un CONJUNTO, y
      guardarlo por trozos dejaría estados intermedios que no significan nada.

      La pantalla dejó de ser de solo lectura aquí, y era la última que lo
      prometía. El motivo no es cosmético: el alta decide el ámbito una vez, y
      sin esto quien acotara de más dejaría al agente sin material para siempre.
      El rediseño ya lo pedía al pie del alcance —«se puede ampliar más tarde». %>
  <%= form_with url: project_initiative_scope_path(@project, @initiative),
                data: { controller: "scope",
                        action: "change->scope#render",
                        scope_intact_value: "sin recortar · entra todo, también lo que se suba después",
                        scope_trimmed_value: "recortado a %{n} de %{total}" } do |form| %>

    <%# ⚠ LAS DOS VERSIONES DE LA CABECERA, y la diferencia importa.

        Sin sellar, «EN EL ÁMBITO (0)» sería mentira: entra todo lo de abajo. Se
        dice con palabras en vez de pintar una tarjeta vacía diciendo «Ninguna»
        mientras el agente recibe nueve fuentes. %>
    <% if @initiative.sources_scoped? %>
      <%= section_header "EN EL ÁMBITO DE ESTE EVOLUTIVO",
                         count: @scoped.values.sum(&:size),
                         gloss: "ámbito es un filtro, no posesión · " \
                                "un documento puede servir a varios evolutivos" %>

      <div class="mt-[9px] grid grid-cols-2 gap-3">
        <%= render "sources/card", label: "DOCS", group: @scoped[:documents],
                   shared: @shared, scoped: true, selectable: true,
                   marked: @marked %>
        <%= render "sources/card", label: "REUNIONES", group: @scoped[:meetings],
                   shared: @shared, scoped: true, selectable: true,
                   marked: @marked %>
      </div>
    <% else %>
      <%= section_header "EL ÁMBITO DE ESTE EVOLUTIVO",
                         gloss: "ámbito es un filtro, no posesión · " \
                                "un documento puede servir a varios evolutivos" %>

      <p class="mt-[9px] p-[11px_12px] border border-terminal-border-gold
                bg-[rgba(196,155,94,.06)] text-t105 leading-[1.65] text-terminal-fg-2">
        <span class="text-antique-gold">Sin recortar</span>: entra todo lo de
        abajo, y también lo que se suba después. Desmarca lo que no deba entrar y
        el ámbito queda fijado a lo que quede marcado.
      </p>
    <% end %>

  <%# ── DEL PROYECTO ──────────────────────────────────────────────────────
      Los documentos SUBIDOS aquí (F12). Van entre lo acotado y lo del cliente
      porque ese es el orden de cercanía: lo de este evolutivo, lo de este
      proyecto, lo de quien está detrás del proyecto.

      Se pinta SIEMPRE, también vacía y también en un proyecto de cliente: a
      diferencia de la del cliente —que promete una carpeta que un proyecto
      propio nunca va a tener— esta sí se puede llenar desde la ficha del
      proyecto, y decir que está vacía es decir dónde se empieza. %>
  <%= section_header "DEL PROYECTO",
                     count: @own.values.sum(&:size), tone: :gate2,
                     gloss: "subidos a #{@project.slug} · " \
                            "se citan igual, sin pasar por platform" %>

  <div class="mt-[9px] grid grid-cols-2 gap-3">
    <%= render "sources/card", label: "DOCS · PROYECTO",
               group: @own[:documents], shared: @shared, scoped: false,
               selectable: true, marked: @marked %>
    <%# La segunda columna no es una tarjeta vacía: matrix no acepta
        transcripciones propias, y una tarjeta «REUNIONES · PROYECTO» diciendo
        «Ninguna» insinuaría que algún día se llenará por aquí. %>
    <p class="self-start p-[11px_12px] border border-dashed border-terminal-border
              text-t105 leading-[1.65] text-terminal-fg-3">
      Las transcripciones no se suben a matrix: llegan de identia-platform, que
      es donde se graban las reuniones.
    </p>
  </div>

  <%# ── HEREDADAS ─────────────────────────────────────────────────────────
      Lo que NO está acotado a este evolutivo. El borde discontinuo es el mismo
      idioma que el chip de cita derivada: lo que no se declaró explícitamente.

      La sección entera es DEL CLIENTE, así que un proyecto PROPIO no la tiene:
      pintarla vacía decía «HEREDADAS DE MATRIX-INTERNA · documentación general
      del cliente», que promete un cliente que no existe y una carpeta que nunca
      se va a llenar. Que no esté es el estado correcto. %>
  <% if @client %>
    <%= section_header "HEREDADAS DE #{@client.slug.upcase}",
                       count: @inherited.values.sum(&:size), tone: :gate2,
                       gloss: "documentación general del cliente" %>

    <div class="mt-[9px] grid grid-cols-2 gap-3">
      <%= render "sources/card", label: "DOCS · CLIENTE",
                 group: @inherited[:documents], shared: @shared, scoped: false,
                 selectable: true, marked: @marked %>
      <%= render "sources/card", label: "REUNIONES · CLIENTE",
                 group: @inherited[:meetings], shared: @shared, scoped: false,
                 selectable: true, marked: @marked %>
    </div>
  <% else %>
    <p class="mt-3 p-[11px_12px] border border-dashed border-terminal-border
              text-t105 leading-[1.65] text-terminal-fg-3">
      Un proyecto propio no hereda documentación de ningún cliente: lo que un
      agente pueda leer aquí es lo que se registre en este proyecto. La frontera
      no tiene puerta trasera.
    </p>
  <% end %>

    <div class="mt-3 flex items-baseline gap-3">
      <%= form.submit "guardar el ámbito ⏎",
                      class: "cursor-pointer border border-terminal-border-gold
                              bg-[rgba(196,155,94,.12)] px-3 py-1.5 text-t11
                              text-antique-gold hover:bg-[rgba(196,155,94,.2)]" %>
      <span class="text-t10 text-terminal-fg-3" data-scope-target="state">
        <%= @initiative.sources_scoped? ? "recortado" : "sin recortar · entra todo, también lo que se suba después" %>
      </span>
      <%# Marcarlo todo NO es «acotar a todo»: es decir que no hay recorte, y
          entonces el evolutivo vuelve a recibir lo que se suba mañana. Decirlo
          aquí es lo que hace reversible el recorte. %>
      <span class="ml-auto text-t10 text-terminal-fg-3">
        márcalo todo para volver a heredarlo todo
      </span>
    </div>
  <% end %>

  <%# ── La caja de cierre ──────────────────────────────────────────────────
      UNA excepción, no dos. La maqueta enumeraba también los clones efímeros
      de SERAPH; al decidirse en F10 que SERAPH lee el CI del repositorio en vez
      de ejecutar nada, esa excepción desapareció. Es lo único de la maqueta que
      se cae por haberse simplificado el sistema, y no por un desliz suyo. %>
  <div class="mt-4 border-l-2 border-terminal-border-fail
              bg-[rgba(201,128,112,.08)] px-3.5 py-2.5
              text-t11 leading-[1.55] text-terminal-fg-3">
    <span class="text-terminal-fg">
      Matrix nunca modifica un origen, y no ejecuta código ajeno.
    </span>
    Una sola excepción, acotada:
    <span class="text-antique-gold">·</span>
    Matrix escribe en <span class="text-antique-gold">artifacts://</span> —
    markdown versionado, claves inmutables, sin borrado.
  </div>
</div>
